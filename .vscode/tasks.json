{
  // .vscode/tasks.json
  "version": "2.0.0",
  "tasks": [
    {
      // Compila a solucao em Debug/x86 forcando o toolset instalado (v145),
      // ja que os projetos pedem v143 (VS2022), que nao esta instalado.
      "label": "Compilar Quake III (Debug, v145)",
      "type": "process",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "${workspaceFolder}\\code\\quake3.sln",
        "/p:Configuration=Debug;Platform=x86;PlatformToolset=v145",
        "/m",
        "/v:minimal",
        "/nologo"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      // Variante Release (otimizada).
      "label": "Compilar Quake III (Release, v145)",
      "type": "process",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "${workspaceFolder}\\code\\quake3.sln",
        "/p:Configuration=Release;Platform=x86;PlatformToolset=v145",
        "/m",
        "/v:minimal",
        "/nologo"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
