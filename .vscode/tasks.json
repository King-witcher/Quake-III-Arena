{
    // Build tasks for Quake III Arena (x64).
    //
    // The whole project targets x64 -- hardware ray tracing (r_raytracing) needs it
    // (the 32-bit NVIDIA Vulkan driver has no ray query).  The VS solution has no x64
    // solution-config, so .vscode\build-x64.ps1 builds each project directly
    // (quake3 + the three game DLLs) with the v145 toolset override (VS 2026, no v143)
    // and deploys the game DLLs to run\dev.  The engine links the renderer statically,
    // so it is rebuilt by the same script.
    //
    // Filesystem layout (all on a space-free path):
    //   run\baseq3\*.pk3            retail data, copied from the Steam install
    //   run\dev\*x86.dll            our x64 game DLLs (legacy "x86" names; loaded as fs_game=dev)
    //   run\dev\vm\*.qvm            our QVMs (override the retail ones in the paks)
    //
    // launch.json points at the composite tasks at the bottom.
    "version": "2.0.0",
    "tasks": [
        {
            // One-time copy of the retail paks from Steam into run\baseq3 (no
            // spaces in the path). /d = only newer, /i = dest is a dir, /y =
            // overwrite, /q = quiet. Edit the source path if Steam is elsewhere.
            "label": "sync: Steam data -> run\\baseq3",
            "type": "process",
            "command": "xcopy",
            "args": [
                "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Quake 3 Arena\\baseq3\\*.pk3",
                "${workspaceFolder}\\run\\baseq3\\",
                "/d", "/i", "/y", "/q"
            ],
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            // x64 engine + game DLLs -> run\dev (build-x64.ps1).
            "label": "build: x64 (Debug)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\.vscode\\build-x64.ps1",
                "-Root", "${workspaceFolder}", "-Config", "Debug"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "group": "build"
        },
        {
            "label": "build: x64 (Release)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\.vscode\\build-x64.ps1",
                "-Root", "${workspaceFolder}", "-Config", "Release"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "group": "build"
        },
        {
            // engine only (x64) -- for the QVM configs, which don't need the game DLLs.
            "label": "msbuild: quake3 engine (x64 Debug)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "${workspaceFolder}\\code\\quake3.vcxproj",
                "/p:Configuration=Debug;Platform=x64;PlatformToolset=v145",
                "/m", "/nologo"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "group": "build"
        },
        {
            "label": "msbuild: quake3 engine (x64 Release)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "${workspaceFolder}\\code\\quake3.vcxproj",
                "/p:Configuration=Release;Platform=x64;PlatformToolset=v145",
                "/m", "/nologo"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "group": "build"
        },
        {
            "label": "build: QVMs (lcc + q3asm)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\.vscode\\build-qvm.ps1",
                "-Root", "${workspaceFolder}"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "group": "build"
        },

        // ---- composite tasks used as preLaunchTask in launch.json (all x64) ----
        {
            "label": "Quake3: build DLL (Debug)",
            "dependsOrder": "sequence",
            "dependsOn": [ "sync: Steam data -> run\\baseq3", "build: x64 (Debug)" ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Quake3: build DLL (Release)",
            "dependsOrder": "sequence",
            "dependsOn": [ "sync: Steam data -> run\\baseq3", "build: x64 (Release)" ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Quake3: build QVM (Debug engine)",
            "dependsOrder": "sequence",
            "dependsOn": [ "sync: Steam data -> run\\baseq3", "msbuild: quake3 engine (x64 Debug)", "build: QVMs (lcc + q3asm)" ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Quake3: build QVM (Release engine)",
            "dependsOrder": "sequence",
            "dependsOn": [ "sync: Steam data -> run\\baseq3", "msbuild: quake3 engine (x64 Release)", "build: QVMs (lcc + q3asm)" ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
